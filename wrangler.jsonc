{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "codesdot-workmonitor",
	"main": "./worker/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codesdot-workmonitor-db",
			"database_id": "ecffd220-5f6d-4c07-a7c1-81d6765d57d1"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SCREENSHOTS",
			"id": "ee8e527fbb8b4958926a639b760e4055",
			"remote": true
		}
	]
}